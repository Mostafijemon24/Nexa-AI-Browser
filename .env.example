# NEXA never ships secrets. Do not commit .env files.
# Desktop-app tokens belong in OS secure storage at runtime, not files.

# ---------------------------------------------------------------------------
# Desktop app (build-time, NOT secret)
# ---------------------------------------------------------------------------
# Public HTTPS URL of the NEXA AI Gateway baked into packaged builds.
# This is only a URL — never put any provider key in a client variable.
MAIN_VITE_NEXA_AI_GATEWAY_URL=

# Optional direct-provider keys for local development only (normally entered in
# Settings → AI and kept in OS secure storage).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# NEXA AI Gateway (server only — see server/.env.example for the full list)
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# AI_ENCRYPTION_KEY=
