# NEXA AI Gateway — server environment. Copy to server/.env (git-ignored) or
# inject via your process manager / secret store. Never commit real values.
# Optional settings are commented out; uncomment only the ones you change
# (an empty assignment still overrides the deployment defaults).
# Any *secret* may instead be provided as a file path via <NAME>_FILE
# (e.g. OPENROUTER_API_KEY_FILE=/run/secrets/openrouter_api_key).

# development | production (production enforces secrets + HTTPS)
# NODE_ENV=

# --- Secrets (required in production) ---------------------------------------
# Server-side OpenRouter key used for NEXA Free AI.
OPENROUTER_API_KEY=
# 32-byte master key for BYOK encryption (AES-256-GCM), hex or base64.
# Generate: openssl rand -hex 32   — store it outside the database.
AI_ENCRYPTION_KEY=

# --- Network / TLS ------------------------------------------------------------
# AI_GATEWAY_HOST=
# PORT=
# Set true only when running behind a TLS-terminating reverse proxy you control.
# AI_TRUST_PROXY=
# Or terminate TLS in-process:
# AI_TLS_CERT_FILE=
# AI_TLS_KEY_FILE=
# Comma-separated browser origins allowed by CORS (Electron main needs none).
# AI_CORS_ORIGINS=
# AI_PUBLIC_REFERER=
# AI_APP_TITLE=

# --- Storage ------------------------------------------------------------------
# AI_DB_PATH=
# AI_AUDIT_RETENTION_DAYS=

# --- Models -------------------------------------------------------------------
# Defaults: openrouter/free and openrouter/auto. Allow-lists are comma separated
# patterns (exact, prefix*, *suffix, *).
# AI_FREE_MODEL=
# AI_FREE_MODELS=
# AI_PREMIUM_DEFAULT_MODEL=
# AI_PREMIUM_MODELS=
# AI_MODEL_CACHE_TTL_SECONDS=

# --- Limits -------------------------------------------------------------------
# AI_FREE_REQUESTS_PER_MINUTE=
# AI_FREE_REQUESTS_PER_DAY=
# Free requests per client IP per day (all devices behind it) and across all
# users per day (0 disables the global cap; default 1000).
# AI_FREE_REQUESTS_PER_IP_PER_DAY=
# AI_FREE_REQUESTS_GLOBAL_PER_DAY=
# AI_MAX_INPUT_TOKENS=
# AI_MAX_OUTPUT_TOKENS=
# AI_PREMIUM_REQUESTS_PER_MINUTE=
# AI_PREMIUM_REQUESTS_PER_DAY=
# AI_PREMIUM_MAX_INPUT_TOKENS=
# AI_PREMIUM_MAX_OUTPUT_TOKENS=
# AI_IP_REQUESTS_PER_MINUTE=
# AI_DEVICE_REQUESTS_PER_MINUTE=
# AI_DEVICE_REGISTRATIONS_PER_IP_PER_HOUR=
# AI_MAX_CONCURRENT_PER_USER=
# AI_DEVICE_TOKEN_TTL_DAYS=
# AI_MAX_BODY_BYTES=
# AI_PROVIDER_TIMEOUT_MS=
