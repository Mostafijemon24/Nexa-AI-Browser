<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS Hardened Runtime entitlements for NEXA (signing readiness).
  These are the minimum entitlements an Electron/Chromium app needs under the
  Hardened Runtime so notarization succeeds. They do NOT grant the app any
  privileged capability by themselves and are inert unless a Developer ID
  signing identity is present at package time.
-->
<plist version="1.0">
  <dict>
    <!-- Chromium/V8 JITs JavaScript; required under Hardened Runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Electron loads its framework dylibs; allow at your own DYLD path. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
