{
  "name": "nexa",
  "productName": "NEXA",
  "version": "0.1.0",
  "description": "The open-source AI browser built around downloads",
  "author": "NEXA",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "server:build": "vite build --config server/vite.config.ts",
    "server:start": "node server/dist/index.mjs",
    "server:dev": "npm run server:build && node --env-file-if-exists=server/.env server/dist/index.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:rc1": "vitest run --config vitest.rc1.config.ts",
    "test:watch": "vitest",
    "package": "npm run clean && npm run build && electron-builder",
    "package:mac": "npm run clean && npm run build && electron-builder --mac",
    "package:win": "npm run clean && npm run build && electron-builder --win",
    "package:linux": "npm run clean && npm run build && electron-builder --linux",
    "clean": "rm -rf out dist"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
